@startuml 001-activity-session-class
!pragma layout smetana
skinparam defaultFontName "Microsoft JhengHei"
skinparam classAttributeIconSize 0
title 001 活動與階段同步 — 類別圖

package "核心（純資料與純函式）" {
  enum Stage <<資料>> {
    準備中
    搶答中
    結果未定案
    結果已定案
    已結束
    已取消
  }

  class Activity <<資料>> {
    code : 活動代碼（6 碼，排除 0、O、1、I）
    stage : Stage
    version : 狀態版本（遞增）
    teacher : TeacherIdentity
    questionNumbers : 題號清單（由 002 提供）
    solvedQuestions : 已成功題號（由 004 定案後提供）
    groups : Group 清單
    rounds : Round 清單
  }

  class TeacherIdentity <<資料>> {
    token : 老師身分憑證（同瀏覽器分頁共用，不可由代碼推導）
  }

  class Group <<資料>> {
    name : 去除首尾空白後的組名
    joinCredential : 組別加入憑證（6 碼；本組裝置與老師可見）
    successCount : 歷史成功次數
    hasSubmissions : 是否有提交紀錄（由 003 提供）
  }

  class DeviceIdentity <<資料>> {
    token : 裝置身分
    role : 老師／學生
    groupName : 所屬組別（學生）
  }

  class Round <<資料>> {
    number : 輪次編號
    rules : RoundRules
    baseline : 各組歷史成功次數基準
    closed : 是否已關輪（只能一次）
  }

  class RoundRules <<資料，開輪後不可變>> {
    questionNumbers : 所選題號（至少 1 題，皆未成功）
    fairMode : 公平模式（預設關）
    deadline : 截止時間（可無；開輪時間 + 1～3600 秒）
  }

  class Command <<資料>> {
    kind : 建立／加入／離開本組／刪除組別／
    開輪／關輪／定案／結束／取消
    requester : DeviceIdentity
    requestId : 重送去重用識別
    payload
  }

  class FinalizeOutcome <<資料，由 004 提供>> {
    solvedQuestions : 本輪新成功題號
    successIncrements : 各組成功次數增量
  }

  class Transition <<資料>> {
    ok : 是否成功
    activity : 新的 Activity
    rejection : RejectionReason
    changed : 是否真的改變（決定版本與推送）
    issued : 新產生的憑證／token（由服務層傳入）
  }

  enum RejectionReason <<資料>> {
    非老師
    階段不允許
    未匯入題目
    選題無效
    倒數秒數無效
    組名無效
    憑證錯誤
    活動已失效
    規則不可修改
    搶答中不可換組
    組別已有提交
  }

  class ActivityStateMachine <<純函式>> {
    +apply(activity, command, now) : Transition
    +isDeadlinePassed(round, now) : bool
  }

  class InputRules <<純函式>> {
    +normalizeGroupName(raw) : 組名或錯誤
    +validateCountdown(raw) : 秒數或錯誤
    +validateSelection(selected, imported, solved) : 題號或錯誤
  }

  class SnapshotView <<純函式>> {
    +forTeacher(activity) : ActivitySnapshot
    +forGroup(activity, groupName) : ActivitySnapshot
  }

  class ActivitySnapshot <<資料>> {
    stage
    version
    roundNumber
    openQuestions
    ownGroup : 只含自己組與本組憑證（學生版）
    groups : 全部組別與憑證（老師版）
    unsolvedQuestions : 結束時列出
  }
}

package "應用層" {
  class ActivityService {
    +create(requestId) : 代碼與老師身分
    +join(code, name, credential) : 裝置身分
    +openRound(requester, rules, now)
    +closeRound(requester, now)
    +finalize(requester, outcome) : 由 004 觸發
    +end(requester)
    +cancel(requester)
    +leaveGroup(device)
    +deleteGroup(requester, groupName)
    +snapshot(device) : ActivitySnapshot
    .. 002 ActivityGateway（皆加上 code 參數） ..
    +stage() : Stage
    +isTeacher(requester) : bool
    +replaceQuestions(questionNumbers)
    .. 003 介面 ..
    +resolveDevice(deviceToken) : DeviceContext
    +acceptsSubmission(now) : bool
    +markGroupSubmitted(groupName)
    .. 004／005 介面 ..
    +currentRound() : Round
    +exportView(requester) : ExportView
  }

  class ActivityRegistry {
    activities : 代碼 → Activity（只在記憶體）
    processed : 身分＋Idempotency-Key → 原回應
    locks : 每個活動一把鎖
  }

  class CountdownScheduler {
    +schedule(code, deadline)
  }
}

package "外層轉接層" {
  interface SyncPublisher {
    +publish(code, snapshotsByDevice)
  }
  interface Clock {
    +now() : 時間
  }
}

Activity "1" *-- "1" TeacherIdentity
Activity "1" *-- "*" Group
Activity "1" *-- "*" Round
Activity --> Stage
Round "1" *-- "1" RoundRules
DeviceIdentity ..> Group : 指向
ActivityStateMachine ..> Activity
ActivityStateMachine ..> Command
ActivityStateMachine ..> Transition
ActivityStateMachine ..> FinalizeOutcome
ActivityStateMachine ..> InputRules
Transition --> RejectionReason
SnapshotView ..> ActivitySnapshot

ActivityService ..> ActivityStateMachine
ActivityService ..> SnapshotView
ActivityService --> ActivityRegistry
ActivityService ..> SyncPublisher
ActivityService ..> Clock : 取得 now 後傳入核心
CountdownScheduler ..> ActivityService : 到期呼叫 closeRound
@enduml
