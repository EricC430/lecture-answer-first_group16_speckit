@startuml 007-browser-identity-sync-class
!pragma layout smetana
skinparam defaultFontName "Microsoft JhengHei"
title 007 同一瀏覽器共用學生身分 — 類別圖（概念模型）

class Activity <<001>> {
  code: 活動代碼
  maxGroups: 組數上限
  stage: 階段
}

class Group <<001>> {
  number: 組號
  joinCredential: 加入憑證
  hasSubmissions: 是否有提交紀錄
}

class BrowserIdentity <<007：取代 001 學生端的 DeviceIdentity>> {
  activityCode: 所屬活動
  groupNumber: 所屬組別
  valid: 是否有效
  --
  同一瀏覽器所有分頁共用
  離開本組／組別被刪除／後端重啟時失效
}

class TeacherIdentity <<001>> {
  activityCode: 所屬活動
  --
  與 BrowserIdentity 分開保存、各自解除
}

class StudentTab {
  畫面狀態: 加入畫面／組別畫面／活動已失效
  --
  收到「身分已變更」時重新取得身分與快照
}

class JoinRule <<core 純函式>> {
  canJoin(browserHasGroup, stage, number, credential) : 允許或拒絕原因
  releaseOnLeave(remainingBrowsers, hasSubmissions) : 是否釋放組號
}

Activity "1" *-- "0..N" Group
Group "1" o-- "0..*" BrowserIdentity : 成員
Activity "1" -- "1" TeacherIdentity
BrowserIdentity "1" -- "1..*" StudentTab : 共用（同一瀏覽器）
JoinRule ..> BrowserIdentity : 判定
@enduml
