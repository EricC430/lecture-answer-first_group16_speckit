# 002-guided-notes-import：Google 連線設定（真實路徑才需要；自動化測試不需要）。
# 複製為 .env 並填值；.env 已被 .gitignore 排除，不要提交，也不要貼到聊天、Issue 或 PR。
# 用 `python -m lecture_quiz` 啟動時會自動載入 .env。任何一項是空字串都視為未設定。
# 設定步驟見 specs/002-guided-notes-import/quickstart.md。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# 本機固定值（埠號 8000、主機名稱 localhost，結尾不加斜線）：
# OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/callback
OAUTH_REDIRECT_URI=
